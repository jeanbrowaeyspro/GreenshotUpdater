<Window x:Class="GreenshotUpdater.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Icon="/GreenshotUpdater.App;component/assets/icon.ico"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel Margin="22,20,22,20">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button MinWidth="100" Margin="8,0,0,0" Content="Installer" Command="{Binding InstallCommand}" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button MinWidth="100" Margin="8,0,0,0" Content="Plus tard" Command="{Binding CloseCommand}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
