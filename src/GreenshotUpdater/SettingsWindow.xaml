<Window x:Class="GreenshotUpdater.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Icon="/GreenshotUpdater.App;component/assets/icon.ico"
        Width="500" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,4,16,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,20">
        <!-- Versions de Greenshot : masquées pendant l'installation. -->
        <StackPanel Visibility="{Binding ShowsSettings, Converter={StaticResource Visible}}">
            <TextBlock Text="Greenshot" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Version installée" Style="{StaticResource Label}" />
                    <TextBlock Grid.Column="1" Text="{Binding InstalledVersionText}" Style="{StaticResource Value}" />
                    <TextBlock Grid.Row="1" Text="Dernière version stable" Style="{StaticResource Label}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestVersionText}" Style="{StaticResource Value}" />
                    <Button MinWidth="100" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center"
                            Content="Vérifier maintenant" Command="{Binding CheckCommand}" />
                </Grid>
            </Border>
        </StackPanel>

        <TextBlock Text="Options" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Panel}">
            <StackPanel>
                <CheckBox Margin="0,2" Content="Démarrer avec Windows" IsChecked="{Binding RunAtStartup}" />
                <CheckBox Margin="0,2" Content="Désactiver la vérification intégrée de Greenshot"
                          IsChecked="{Binding DisableGreenshotUpdateCheck}" />
                <CheckBox Margin="0,2" Content="Raccourci sur le Bureau" IsChecked="{Binding DesktopShortcut}" />
                <CheckBox Margin="0,2" Content="Raccourci dans le menu Démarrer" IsChecked="{Binding StartMenuShortcut}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,14"
                   Foreground="{DynamicResource MutedTextBrush}" />

        <DockPanel LastChildFill="False">
            <!-- Pendant l'installation, seul le bouton "Installer" est affiché. -->
            <Button MinWidth="100" DockPanel.Dock="Left" Content="Désinstaller" Command="{Binding UninstallCommand}"
                    Visibility="{Binding ShowsSettings, Converter={StaticResource Visible}}" />
            <Button MinWidth="100" Margin="8,0,0,0" DockPanel.Dock="Right" Content="Fermer" IsCancel="True" Click="OnClose"
                    Visibility="{Binding ShowsSettings, Converter={StaticResource Visible}}" />
            <Button MinWidth="100" Margin="8,0,0,0" DockPanel.Dock="Right" Content="{Binding ApplyText}" Command="{Binding ApplyCommand}"
                    IsDefault="True" Style="{DynamicResource AccentButtonStyle}" />
        </DockPanel>
    </StackPanel>
</Window>
